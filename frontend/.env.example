# Frontend — copy to .env.local for local override or set in Vercel Project Settings.
# Never commit real secrets.

# Leave empty for Vercel multi-service (same-origin /api → backend) or local CRA proxy.
# Set only when the API is on a different host (e.g. Render):
# REACT_APP_API_URL=https://your-api.onrender.com
REACT_APP_API_URL=
