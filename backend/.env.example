# =============================================================================
# Church Management System — backend environment (names + safe placeholders)
# Copy to .env for local use. NEVER commit real .env files or production secrets.
# Also see: .env.development.example, .env.staging.example, .env.production.example
# Docs: ../docs/ENVIRONMENT.md
# =============================================================================

# DATABASE_URL=
# Preferred for production (Neon). When set, SQLite is not used.
# SERVE_FRONTEND=
# Set 0 on Render when the UI is hosted on Vercel.

PORT=5000
NODE_ENV=development

# REQUIRED in production/staging — long random string (32+ chars). Leave empty here;
# set the real value only in local .env or the host secret manager.
JWT_SECRET=

# REQUIRED in production/staging — comma-separated browser origins
# CORS_ORIGIN=

# Public app URL (password reset / email links)
# APP_URL=

# Optional SQLite / storage paths (e.g. persistent disk)
# DATABASE_PATH=
# UPLOADS_PATH=
# BACKUP_PATH=

# Behind Render / nginx
# TRUST_PROXY=

# Rate limits (requests per window)
# API_RATE_LIMIT=
# WRITE_RATE_LIMIT=
# AUTH_RATE_LIMIT=

# Backup retention
# BACKUP_RETENTION_DAYS=
# BACKUP_MAX_COUNT=

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Monitoring / logging
# LOG_LEVEL=
# SENTRY_DSN=

# Dev-only: expose password reset tokens in API responses (NEVER in production)
# AUTH_DEBUG_RESET=

# Phase 40 — custom domains / subdomains
# PLATFORM_DOMAIN=
# PLATFORM_ROOT_HOSTS=
# VERIFY_DOMAINS_SKIP_DNS=
