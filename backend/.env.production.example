# Production — set in host secret manager / dashboard ONLY (never commit)
NODE_ENV=production
PORT=5000
JWT_SECRET=REPLACE_WITH_32+_CHAR_RANDOM_SECRET
# Vercel frontend origin(s)
CORS_ORIGIN=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app
# Neon Postgres (preferred)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/church_cms?sslmode=require
# API-only on Render when frontend is on Vercel
SERVE_FRONTEND=0
TRUST_PROXY=1
LOG_LEVEL=info
UPLOADS_PATH=/opt/render/project/data/uploads
BACKUP_PATH=/opt/render/project/data/backups
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@app.example.com
# SENTRY_DSN=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=60
