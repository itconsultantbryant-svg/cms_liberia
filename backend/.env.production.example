# Production — set in host secret manager / dashboard ONLY (never commit)
NODE_ENV=production
PORT=5000
JWT_SECRET=REPLACE_WITH_32+_CHAR_RANDOM_SECRET
CORS_ORIGIN=https://app.example.com
APP_URL=https://app.example.com
DATABASE_PATH=/var/data/production/database.sqlite
UPLOADS_PATH=/var/data/production/uploads
BACKUP_PATH=/var/data/production/backups
TRUST_PROXY=1
LOG_LEVEL=info
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@app.example.com
# SENTRY_DSN=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=60
# Never enable demo seed in production
# ALLOW_DEMO_SEED must remain unset
