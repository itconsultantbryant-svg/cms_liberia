# Staging — set in host secret manager / dashboard (do not commit real values)
NODE_ENV=staging
PORT=5000
JWT_SECRET=REPLACE_WITH_32+_CHAR_RANDOM_SECRET
CORS_ORIGIN=https://staging.example.com
APP_URL=https://staging.example.com
DATABASE_PATH=/var/data/staging/database.sqlite
UPLOADS_PATH=/var/data/staging/uploads
BACKUP_PATH=/var/data/staging/backups
TRUST_PROXY=1
LOG_LEVEL=info
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@staging.example.com
# SENTRY_DSN=
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_COUNT=30
